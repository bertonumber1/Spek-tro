# Normalise line endings in the repository.
#
# Cloning this tree on Windows with core.autocrlf=true rewrote 58 files to CRLF,
# which broke autogen.sh's shebang ("required file not found") in a way that took
# a while to spot. Everything here is LF in the repo and LF on checkout.
* text=auto eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.ico binary
*.bmp binary
*.webp binary
*.gmo binary
*.mo  binary
*.tar.xz binary
*.7z binary
*.flac binary
*.wav binary

# Shell scripts and the build system must stay LF on every platform.
*.sh    text eol=lf
*.ac    text eol=lf
*.am    text eol=lf
*.in    text eol=lf
autogen.sh text eol=lf

# Translation catalogues are text but gettext is picky about them.
*.po  text eol=lf
*.pot text eol=lf
